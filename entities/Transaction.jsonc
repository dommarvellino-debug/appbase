{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "expense",
        "income"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "Food",
        "Housing",
        "Transport",
        "Study",
        "Fun",
        "Health",
        "Income",
        "Other"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title",
    "amount",
    "type",
    "category",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}